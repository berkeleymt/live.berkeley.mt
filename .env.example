# Public API — defaults to /api/live (Vite proxies /api to the local Rust server)
# VITE_API_URL=/api/live

# Public event details and FAQ — path relative to server working directory
# EVENT_CONTENT_PATH=content/event.json
# PORT=3001

# Postmark email notifications (server-side, set in shell env or .env for the Rust server)
# POSTMARK_SERVER_TOKEN=your-postmark-server-token
# POSTMARK_FROM_ADDRESS=noreply@berkeley.mt
# SITE_BASE_URL=https://live.berkeley.mt

# Admin auth — if set, /admin and admin API routes require HTTP Basic Auth
# ADMIN_PASSWORD=your-secret-password
# Event-content publishing requires a nonempty password. Set one for ALL deployments.
