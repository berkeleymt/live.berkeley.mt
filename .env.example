# Do not enable demo mode in production. Prefer `npm run demo` for an isolated local sandbox.
# DEMO_MODE=true
# HOST=127.0.0.1
# PORT=3001
# STATIC_DIR=dist
# VITE_API_URL=/api/live

# Persist these paths outside STATIC_DIR and outside the public Git checkout.
# DATABASE_PATH=/var/lib/bmt-live/data.db
# PRIVATE_DB_PATH=/var/lib/bmt-live/private.db
# SITE_MEDIA_DIR=/var/lib/bmt-live/media

# File mode (default): editable public documents, atomically saved and polled.
# EVENT_CONTENT_PATH=content/event.json
# SITE_CONTENT_PATH=content/site.json
# WAYFINDING_CONTENT_PATH=content/wayfinding.json
# Optional file-mode page directory (default: pages/ beside SITE_CONTENT_PATH).
# Parent must be writable durable storage for staged files/last-good recovery.
# Git modes use their own pages/ tree. See docs/markdown-pages.md before adoption.
# PAGES_CONTENT_DIR=content/pages

# Git modes are mutually exclusive. Read docs/git-publishing.md migration/rollback first.
# Legacy local-first: dedicated worktree, valid operations.json + optional editorial bundle.
# LIVE_CONTENT_REPO=/var/lib/bmt-live/public-content
# Opt-in remote-first: dedicated bare cache with approved origin/credentials configured privately.
# Canonical content/ manifest + operations/event/site/wayfinding/media must be migrated/validated first.
# LIVE_CONTENT_REMOTE_REPO=/var/lib/bmt-live/public-content.git
# LIVE_CONTENT_BRANCH=main
# Synthetic local-path remotes ONLY; never enable this escape hatch in production.
# LIVE_CONTENT_ALLOW_LOCAL_REMOTE=false
# LIVE_CONTENT_RUNTIME_RELOAD is an Actions repository variable, NOT a server env knob.
# Leave it off until actual runtime convergence is verified; see docs/git-publishing.md.

# Google/People is opt-in; no Lemon accounts/cookies are shared. See docs/staff-access.md.
# Review migration and approved Google origins before setting these supported server variables.
# STAFF_AUTH_MODE=google
# GOOGLE_CLIENT_ID=REPLACE_WITH_APPROVED_WEB_CLIENT_ID.apps.googleusercontent.com
# STAFF_STATE_PATH=/var/lib/bmt-live/private/staff-state.json
# SUPER_ADMIN_EMAILS=bootstrap@example.invalid
# Bootstrap emails must be explicit approved accounts; placeholder grants nobody access.
# Google mode fails closed without configuration and never silently falls back to passwords.
# Unset GOOGLE_CLIENT_ID and use STAFF_AUTH_MODE=legacy only for deliberate compatibility mode.
# Named legacy accounts: private mode-0600 JSON with Argon2id hashes; never commit it.
# See docs/staff-access.md. With no accounts/owner password, staff APIs DENY access.
# STAFF_ACCOUNTS_PATH=/var/lib/bmt-live/private/staff.json
# STAFF_PUBLIC_ORIGIN=https://live.berkeley.mt
# STAFF_SESSION_TTL_SECONDS=28800
# STAFF_COOKIE_SECURE=true
# STAFF_COOKIE_SECURE=false is permitted ONLY with DEMO_MODE=true for localhost HTTP.
# Optional legacy owner login/API fallback; set via a secret manager, never this file.
# ADMIN_PASSWORD=

# Optional ContestDojo adapter; DISABLED until private storage is explicitly configured.
# See docs/setup-contestdojo.md. Never use real provider credentials for local/demo testing.
# LIVE_CONTESTDOJO_DB=/var/lib/bmt-live/private/contestdojo.db
# ROSTER_AUTO_SYNC=0
# CONTESTDOJO_EVENT_ID=
# Set CONTESTDOJO_API_TOKEN only through private environment/secrets, never this file.
# Super-only /admin/settings can persist overrides; demo mode never calls the provider.

# Legacy compatibility: private hashed roster import, outside application/content/static directories.
# See docs/wayfinding.md for its schema and approved offline import process.
# PRIVATE_ROSTER_PATH=/var/lib/bmt-live/private/roster.json

# Legacy announcement/subscription email. DEMO_MODE=true disables sending even if a token is present.
# POSTMARK_SERVER_TOKEN=
# POSTMARK_FROM_ADDRESS=noreply@berkeley.mt
# SITE_BASE_URL=https://live.berkeley.mt

# Receipt mail is separately opt-in; no sender or reply-to fallback is used.
# Both plain addresses must be approved berkeley.mt mailboxes; verify sender in Postmark.
# Keep the actual token in private deployment secrets; do not send real mail during tests.
# See docs/lost-found.md (D5 sender/reply monitoring and D6 retention remain open).
# LIVE_LOST_FOUND_MAIL_ENABLED=false
# LIVE_LOST_FOUND_MAIL_FROM=
# LIVE_LOST_FOUND_MAIL_REPLY_TO=
# Uses POSTMARK_SERVER_TOKEN above. DEMO_MODE=true always disables receipt sending.
# PRIVATE_DB_PATH must be durable/private, outside static/public Git; one Live process only.
